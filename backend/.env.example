# Copy to .env and adjust for local development.
# NEVER commit a real .env file with secrets.

APP_NAME="Brand Presenter AI"
APP_ENV=development
DEBUG=true

# SQLite for local development. See README for the PostgreSQL migration path.
DATABASE_URL=sqlite:///./data/brand_presenter.db

# Generate a real secret for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI provider: "mock" (default, no external calls), "gemini", or "openai".
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Symmetric key used to encrypt social OAuth tokens at rest (Fernet key: 32 url-safe base64 bytes).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For local/dev without the `cryptography` package installed, leave blank to use the built-in
# reversible dev-only obfuscation fallback (see app/core/security.py).
TOKEN_ENCRYPTION_KEY=

# Placeholders only - no real social platform credentials are used in this MVP.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
